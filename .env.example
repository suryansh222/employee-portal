# Documentation only: this file is NOT automatically loaded.
# Enter values directly in Railway service Variables.
PORTAL_DATA_DIR=/app/data
PORTAL_SECURE_COOKIE=1
# Appropriate ONLY behind Railway's managed HTTPS proxy. Do not enable a public TCP proxy.
FORWARDED_ALLOW_IPS=*
# First start only. Set your own email and a unique 16+ character password privately.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_ID=ADMIN
PORTAL_ADMIN_FIRST_NAME=Portal
PORTAL_ADMIN_LAST_NAME=Administrator
# Optional additional EXACT custom domains, comma-separated; never use *.
PORTAL_ALLOWED_HOSTS=
# Railway supplies PORT, RAILWAY_PUBLIC_DOMAIN and RAILWAY_VOLUME_MOUNT_PATH.
# Attach an actual volume; do not create the RAILWAY_VOLUME_MOUNT_PATH variable yourself.
